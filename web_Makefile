CC = emcc
CFLAGS = -Wall -Wextra -std=c11 -Wno-unused -O3

# Allows commas to be inserted safely into Makefile lists.
comma := ,

# 1. Exports for the standalone core.
EXPORTED_FUNCS_CORE = \
  '_free', '_malloc', \
  '_short_game_init', '_short_game_free', \
  '_game_new', '_game_from_game', '_game_from_games', \
  '_game_zero', '_game_one', '_game_star', '_game_up', '_game_down', \
  '_game_geq', '_game_canonicalize', '_game_add', '_game_multiply', '_game_negate', \
  '_cool_with_star', '_star_projection', \
  '_make_int', '_make_dyadic', '_make_nimber', \
  '_make_up_multiple', '_make_down_multiple', \
  '_game_get_string', '_game_from_string', '_game_string_last_error', \
  '_game_len', '_game_cap', '_game_free', '_game_reserve', '_game_push', \
  '_game_append', '_game_append_many', '_game_resize', '_game_pop', \
  '_game_first', '_game_last', '_game_remove_unordered'

# 2. Converter exports shared by all compiled C games.
EXPORTED_FUNCS_CONVERT = \
  '_convert', '_convert_component', '_convert_init', '_convert_free', \
  '_num_moves', '_can_left_move', '_can_right_move', \
  '_do_move_left', '_do_move_right', '_hash_raw_game_position', \
  '_get_independent_components'

# ----------------------------------------------------------------------
# 3. Game-specific exports, keyed by the uppercase game name.
# ----------------------------------------------------------------------
EXPORTED_FUNCS_HOTPOTCH = '_cleanup_position'
EXPORTED_FUNCS_DOMINEERING = 
EXPORTED_FUNCS_TOADS_AND_FROGS = 

# ----------------------------------------------------------------------

LDFLAGS_CORE = \
  -s MODULARIZE=1 \
  -s EXPORT_ES6=1 \
  -s ALLOW_MEMORY_GROWTH=1 \
  -s EXPORTED_FUNCTIONS="[$(EXPORTED_FUNCS_CORE)]" \
  -s EXPORTED_RUNTIME_METHODS="['UTF8ToString', 'stringToNewUTF8', 'getValue', 'setValue']"

SRC_DIR = src
SHORTS_DIR = $(SRC_DIR)/short-games/C
CORE_DIR = $(SHORTS_DIR)/core
PARSER_DIR = $(CORE_DIR)/parser

# game_string.c in core is the original parser. The current implementation
# lives in core/parser together with its lexer and semantic evaluator.
CORE_SRCS = $(filter-out $(CORE_DIR)/game_string.c,$(wildcard $(CORE_DIR)/*.c))
PARSER_SRCS = \
  $(PARSER_DIR)/ast.c \
  $(PARSER_DIR)/dyadic_value.c \
  $(PARSER_DIR)/game_format.c \
  $(PARSER_DIR)/game_string.c \
  $(PARSER_DIR)/language_error.c \
  $(PARSER_DIR)/lexer.c \
  $(PARSER_DIR)/parser.c \
  $(PARSER_DIR)/semantic.c \
  $(PARSER_DIR)/token.c
SHORT_CORE_SRCS = $(CORE_SRCS) $(PARSER_SRCS)
CONVERT_SRCS = $(wildcard $(SHORTS_DIR)/convert/*.c)
GAMES_SRC_DIR = $(SHORTS_DIR)/games

INCLUDES = -I$(SHORTS_DIR) -I$(CORE_DIR) -I$(PARSER_DIR) -I$(SHORTS_DIR)/shared -I$(SHORTS_DIR)/convert/convert_interface -I$(GAMES_SRC_DIR)

GAME_DIRS = $(wildcard $(GAMES_SRC_DIR)/*)
GAME_NAMES = $(notdir $(GAME_DIRS))
GAME_TARGETS = $(foreach game,$(GAME_NAMES),web/games/$(game)/lib$(game).js)
CORE_TARGET = web/core/libshortcore.js

.PHONY: all clean games core

all: core games

games: $(GAME_TARGETS)

core: $(CORE_TARGET)

# Converts a game directory name to uppercase (hotpotch -> HOTPOTCH).
TO_UPPER = $(shell echo $(1) | tr '[:lower:]' '[:upper:]')

# Template for compiling one game.
define GAME_TEMPLATE
# Uppercase lookup key for the game.
UP_NAME_$(1) := $$(call TO_UPPER,$(1))

# Combines core and converter exports with optional game-specific exports.
GAME_EXPORTS_$(1) = $(EXPORTED_FUNCS_CORE)$(comma) $(EXPORTED_FUNCS_CONVERT)$$(if $$(EXPORTED_FUNCS_$$(UP_NAME_$(1))),$$(comma) $$(EXPORTED_FUNCS_$$(UP_NAME_$(1))))

web/games/$(1)/lib$(1).js: $(SHORT_CORE_SRCS) $(CONVERT_SRCS) $$(wildcard $(GAMES_SRC_DIR)/$(1)/*.c)
	@echo "Compiling game: $(1)..."
	@mkdir -p web/games/$(1)
	$$(CC) $$(CFLAGS) $$(INCLUDES) $$^ -o $$@ \
		-s MODULARIZE=1 \
		-s EXPORT_ES6=1 \
		-s ALLOW_MEMORY_GROWTH=1 \
		-s EXPORTED_FUNCTIONS="[$$(GAME_EXPORTS_$(1))]" \
		-s EXPORTED_RUNTIME_METHODS="['UTF8ToString', 'stringToNewUTF8', 'getValue', 'setValue']"
endef

# Instantiates the template for every discovered game.
$(foreach game,$(GAME_NAMES),$(eval $(call GAME_TEMPLATE,$(game))))

# Standalone core target.
$(CORE_TARGET): $(SHORT_CORE_SRCS)
	@echo "Compiling standalone core..."
	@mkdir -p web/core
	$(CC) $(CFLAGS) $(INCLUDES) $^ -o $@ $(LDFLAGS_CORE)

clean:
	@echo "Removing generated libraries..."
	rm -f web/core/libshortcore.js web/core/libshortcore.wasm
	rm -f web/games/*/lib*.js web/games/*/lib*.wasm
